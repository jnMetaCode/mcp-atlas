{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "serverId",
      "distributionId",
      "client",
      "clientVersionRange",
      "os",
      "reviewedAt",
      "scope",
      "prerequisites",
      "steps",
      "expectedResult",
      "templateFormat",
      "configPath",
      "configTemplate",
      "notes",
      "troubleshooting",
      "removal",
      "sourceRefs"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "title": { "type": "string", "minLength": 1 },
      "serverId": { "type": "string", "minLength": 1 },
      "distributionId": { "type": "string", "minLength": 1 },
      "client": { "type": "string", "minLength": 1 },
      "clientVersionRange": { "type": "string", "minLength": 1 },
      "os": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "reviewedAt": { "type": "string", "format": "date" },
      "scope": { "const": "documentation" },
      "prerequisites": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "expectedResult": { "type": "string", "minLength": 1 },
      "templateFormat": { "enum": ["json", "connection-info"] },
      "troubleshooting": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "removal": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "configPath": { "type": "string", "minLength": 1 },
      "configTemplate": { "type": "string", "minLength": 2 },
      "notes": { "type": "array", "items": { "type": "string" } },
      "sourceRefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "label"],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "label": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
