{
  "name": "mcp-atlas",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate.mjs && next build",
    "validate": "node scripts/validate.mjs",
    "check:export": "node scripts/check-export.mjs",
    "registry:sync": "node scripts/registry-sync.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:dom": "TSX_TSCONFIG_PATH=tests/tsconfig.dom.json node --import tsx --import ./tests/dom/setup.mjs --test tests/dom/*.test.jsx",
    "format": "prettier --write src scripts tests schemas data *.json *.mjs .github",
    "skills:discover": "node scripts/discover-skills.mjs"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "jsdom": "25.0.1",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
